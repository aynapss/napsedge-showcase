# Phase 9A configuration template. Every value below is a SHAPE, never a
# working credential -- do not copy a real value from any .env file into
# this committed template, and never commit a real .env.
#
# This file documents which process owns each variable, whether it is
# required or optional, a safe default (if one exists), and when it is
# validated. It is not read automatically by any process -- see
# docs/phase9a_deployment_contract.md for how each container actually
# receives its configuration (environment interpolation in compose.yaml,
# or your own deployment platform's secret-injection mechanism).

# =============================================================================
# API (src.api.main / src.deployment.entrypoints api)
# =============================================================================

# Owner: API. Required: yes, for every protected route (fails closed,
# validated at container startup by src.deployment.env_validation and
# again per-request by src.auth.api_keys). Secret: yes.
# Shape: {"<client_id>": "<64-hex-char SHA-256 digest of the real token>"}
NAPSEDGE_API_KEY_HASHES_JSON={"REPLACE_WITH_CLIENT_ID": "REPLACE_WITH_64_HEX_SHA256_DIGEST"}
# Server form (Phase 9 decision 9): instead of the variable above, a read-only credential FILE holding the same JSON.
# Set only one of the two. NAPSEDGE_API_KEY_HASHES_JSON_FILE=/run/secrets/api-key-hashes

# Owner: API. Required: no. Default: 60. Secret: no.
NAPSEDGE_RATE_LIMIT_REQUESTS=60

# Owner: API. Required: no. Default: 60. Secret: no.
NAPSEDGE_RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# Shared (API, Streamlit, and the 3 database-backed Discord commands)
# =============================================================================

# Owner: shared. Required: no -- falls back to a local dev SQLite file
# if unset (never appropriate for a real deployment). Secret: yes (a
# real PostgreSQL DSN embeds credentials).
# Shape: postgresql+psycopg://<user>:<pass>@<host>:5432/<db>
NAPSEDGE_DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/napsedge
# Server form (Phase 9 decision 9): a URL WITHOUT a password plus the password in a read-only credential file, e.g.
#   NAPSEDGE_DATABASE_URL=postgresql+psycopg://napsedge_runtime_ro@REPLACE_HOST:25060/napsedge?sslmode=verify-full&sslrootcert=/run/secrets/db-ca.pem
#   NAPSEDGE_DATABASE_PASSWORD_FILE=/run/secrets/db-password
# A URL that already carries a password is refused when the file is set.

# Owner: shared. Required: no. Default: false. Secret: no.
NAPSEDGE_DATABASE_ECHO=false

# Owner: shared (each process's PostgreSQL engine; Phase 9B-8A). Required:
# no -- an absent value means the default; a malformed one stops the
# process at startup (the variable is named, never its value). Secret: no.
# Each process holds at most POOL_SIZE + MAX_OVERFLOW connections and waits
# at most POOL_TIMEOUT_SECONDS for a free one (the API then answers a
# sanitized, retryable 503). Budget for the selected 1 GiB managed plan
# (22 connections): API + Streamlit + Discord 3 x 4 = 12, the backup job
# about 4, one operator session -- 17 of 22. Raise only with that budget.
# Bounds: POOL_SIZE 1-10 (default 2), MAX_OVERFLOW 0-10 (default 2),
# POOL_TIMEOUT_SECONDS 1-60 (default 10).
NAPSEDGE_DB_POOL_SIZE=2
NAPSEDGE_DB_MAX_OVERFLOW=2
NAPSEDGE_DB_POOL_TIMEOUT_SECONDS=10

# Owner: shared (Rankings). Required: yes, for the Rankings operation on
# the API and on Streamlit page 10 (validated at container startup).
# Secret: no.
NAPSEDGE_NET_RANKINGS_SEASON=2026

# Owner: shared (Rankings). Required: no. Default: the committed
# Reference Py Files/net_rankings_2026.csv. Secret: no.
NAPSEDGE_NET_RANKINGS_CACHE_PATH=Reference Py Files/net_rankings_2026.csv

# Owner: shared. Required: no. Default: the repository root. Secret: no.
NAPSEDGE_ROOT_DIR=/app

# Owner: shared. Required: no. Default: INFO. Secret: no.
NAPSEDGE_LOG_LEVEL=INFO
# Phase 9E-1: `text` (default, unchanged) or `json` (one JSON object per line, with the API request ID; for journald on the
# server). Anything else stops the process at startup. Known secrets are redacted from log lines in both formats.
NAPSEDGE_LOG_FORMAT=text
# Phase 9E-3: the operator command `entrypoints data-freshness` reports a cache as stale above this age (1-720, default 48).
NAPSEDGE_DATA_MAX_AGE_HOURS=48

# =============================================================================
# Streamlit only (private-ingress rehearsal)
# =============================================================================

# Owner: Streamlit only. Required: no -- leave EMPTY unless Streamlit is
# reached through a tunnel/reverse proxy under a non-localhost hostname.
# Default: empty (same as unset; localhost only). Secret: no.
# Why: Streamlit rejects a websocket whose Origin is not localhost with a
# 403, so the page loads but never runs. Set it to exactly ONE origin
# (scheme + host, e.g. https://REPLACE_WITH_YOUR_HOSTNAME); other origins
# stay rejected. Multiple values through this variable were observed to be
# unreliable -- do not list more than one. A random Cloudflare Quick Tunnel
# URL changes on every start, so this must be updated and Streamlit
# restarted each time. This is an origin allowlist, NOT authentication.
# Never pass this to the API or Discord services.
STREAMLIT_SERVER_CORS_ALLOWED_ORIGINS=

# =============================================================================
# Discord (src.discord_bot.bot / src.deployment.entrypoints discord)
# =============================================================================

# Owner: Discord only. Required: yes to start the bot (validated at
# container startup; the process exits before connecting if unset).
# Secret: yes. This value must never be present in the API or Streamlit
# process environment -- confirmed structurally true today (neither
# process imports or reads this variable).
DISCORD_BOT_TOKEN=REPLACE_WITH_REAL_BOT_TOKEN
# Server form (Phase 9 decision 9): DISCORD_BOT_TOKEN_FILE=/run/secrets/discord-bot-token (set only one of the two).

# Owner: Discord only. Required: no. Default: empty allowlist. Secret: no.
DISCORD_ADMIN_USER_IDS=REPLACE_WITH_COMMA_SEPARATED_DISCORD_USER_IDS

# =============================================================================
# Optional local PostgreSQL profile (compose.yaml "local-db" profile)
# =============================================================================
# Owner: the local-db Compose service only -- never a production
# PostgreSQL instance. Required: only if the local-db profile is used.
# Secret: yes, but this project's own compose.yaml never ships a
# committed default for these -- generate your own value before using
# the profile; do not commit a real value here either.
NAPSEDGE_LOCAL_DB_PASSWORD=REPLACE_WITH_A_LOCALLY_GENERATED_VALUE

# =============================================================================
# NOT part of this Phase 9A deployment contract
# =============================================================================
# The following variables belong to processes explicitly excluded from
# Phase 9A's three image targets (the Stripe webhook, and the legacy
# live-Odds/agent pipeline) and are listed here only so their exclusion
# is explicit, not merely implicit by omission:
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_WEBHOOK_PORT,
#   ODDS_API_KEY
