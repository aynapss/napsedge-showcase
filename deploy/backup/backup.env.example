# Phase 9B-8B: the backup container's NON-SECRET configuration (copy to /etc/napsedge-backup/backup.env, mode 0640).
# PLACEHOLDERS ONLY. Credentials are FILE paths inside the container (staged from systemd encrypted credentials).
NAPSEDGE_BACKUP_DATABASE_URL=postgresql+psycopg://napsedge_backup_ro@<host>:<port>/<database>?sslmode=verify-full&sslrootcert=/run/napsedge-backup/ca/ca.pem
NAPSEDGE_BACKUP_DATABASE_PASSWORD_FILE=/run/napsedge-backup/credentials/db-password
NAPSEDGE_BACKUP_TARGET_ACKNOWLEDGEMENT=<the exact acknowledgement phrase for the database>
NAPSEDGE_BACKUP_EXPECTED_SYSTEM_IDENTIFIER=<read by the backup role (the probe's identity step)>
NAPSEDGE_BACKUP_EXPECTED_DATABASE_OID=<read by the backup role>
NAPSEDGE_BACKUP_STORE_DIR=/var/lib/napsedge-backup/store
NAPSEDGE_BACKUP_STATE_DIR=/var/lib/napsedge-backup/state
NAPSEDGE_BACKUP_LOGICAL_NAME=napsedge
NAPSEDGE_BACKUP_PG_DUMP=/usr/lib/postgresql/16/bin/pg_dump
NAPSEDGE_BACKUP_PG_RESTORE=/usr/lib/postgresql/16/bin/pg_restore
NAPSEDGE_BACKUP_GIT_REVISION=<40-hex revision>
NAPSEDGE_BACKUP_GIT_DIRTY=<true|false>
NAPSEDGE_BACKUP_TOOLING_VERSION=<label>
# Operating targets: the configured defaults (bounds in src/deployment/backup_operations.py). Configured, not measured.
NAPSEDGE_BACKUP_RPO_HOURS=24
NAPSEDGE_BACKUP_RTO_HOURS=4
NAPSEDGE_BACKUP_OVERLAP_ATTEMPTS=4
NAPSEDGE_BACKUP_OVERLAP_DELAY_SECONDS=900
NAPSEDGE_BACKUP_CYCLE_DEADLINE_SECONDS=7200
NAPSEDGE_BACKUP_UPLOAD_ATTEMPTS=3
NAPSEDGE_BACKUP_UPLOAD_BACKOFF_SECONDS=30
NAPSEDGE_BACKUP_RETAIN_DAILY=7
NAPSEDGE_BACKUP_RETAIN_WEEKLY=4
NAPSEDGE_BACKUP_RETAIN_MONTHLY=6
NAPSEDGE_BACKUP_DRILL_INTERVAL_DAYS=31
# Remote operations: OFF until deployment.
NAPSEDGE_BACKUP_OFFSITE_ENABLED=false
NAPSEDGE_BACKUP_RETENTION_DELETE_ENABLED=false
NAPSEDGE_BACKUP_OFFSITE_ENDPOINT_URL=https://s3.<region>.backblazeb2.com
NAPSEDGE_BACKUP_OFFSITE_REGION=<region>
NAPSEDGE_BACKUP_OFFSITE_BUCKET=<bucket>
NAPSEDGE_BACKUP_OFFSITE_PREFIX=napsedge
NAPSEDGE_BACKUP_OFFSITE_KEY_ID_FILE=/run/napsedge-backup/credentials/offsite-key-id
NAPSEDGE_BACKUP_OFFSITE_SECRET_KEY_FILE=/run/napsedge-backup/credentials/offsite-secret-key
NAPSEDGE_BACKUP_RECIPIENTS_FILE=/run/napsedge-backup/recipients/recipients.txt
