# Phase 9 decision 9 (approved 2026-10-09): PREPARED, NOT INSTALLED -- turns the application's systemd encrypted credentials into
# read-only files for the containers. Each secret is decrypted by systemd into this unit's private credentials directory, then copied
# into a RAM-only directory (/run/napsedge-app-secrets, mode 0700) owned by the containers' user (uid 10001), each file 0400.
# compose.secrets.example.yaml mounts them read-only at /run/secrets/<name>. Nothing is written to disk; the directory is removed
# when this unit stops (so `systemctl stop` revokes the files; restart the app after rotating a secret).
#
# To activate (at deployment, on the server):
#   1. For each secret, paste its value on stdin (never as an argument):
#        systemd-creds encrypt --name=db-password - /etc/credstore.encrypted/napsedge-app-db-password
#        systemd-creds encrypt --name=api-key-hashes - /etc/credstore.encrypted/napsedge-app-api-key-hashes
#        systemd-creds encrypt --name=discord-bot-token - /etc/credstore.encrypted/napsedge-app-discord-bot-token
#   2. install -m 0644 this file as /etc/systemd/system/napsedge-app-secrets.service; systemctl daemon-reload
#   3. systemctl enable --now napsedge-app-secrets.service, then start compose with compose.secrets.example.yaml.
# Numeric owner via chown (never `install -o`: uutils coreutils refuses a numeric owner without an account; 9B-8C WSL rehearsal).
[Unit]
Description=NapsEdge application secrets as read-only files (Phase 9 decision 9)
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
LoadCredentialEncrypted=db-password:/etc/credstore.encrypted/napsedge-app-db-password
LoadCredentialEncrypted=api-key-hashes:/etc/credstore.encrypted/napsedge-app-api-key-hashes
LoadCredentialEncrypted=discord-bot-token:/etc/credstore.encrypted/napsedge-app-discord-bot-token
ExecStart=/bin/sh -c 'set -e; umask 077; mkdir -p /run/napsedge-app-secrets; chmod 0700 /run/napsedge-app-secrets; for c in db-password api-key-hashes discord-bot-token; do install -m 0400 "$CREDENTIALS_DIRECTORY/$c" "/run/napsedge-app-secrets/$c"; chown 10001:10001 "/run/napsedge-app-secrets/$c"; done; chown 10001:10001 /run/napsedge-app-secrets'
ExecStop=/bin/rm -rf /run/napsedge-app-secrets

[Install]
WantedBy=multi-user.target
